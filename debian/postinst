#!/bin/sh
# Tells the desktop about the program that was just installed: the menu entry
# and the icon cache are read from disk by the desktop, and both are only
# refreshed when something asks for it.
set -e

case "$1" in
    configure)
        if command -v update-desktop-database >/dev/null 2>&1; then
            update-desktop-database -q /usr/share/applications || true
        fi
        if command -v gtk-update-icon-cache >/dev/null 2>&1; then
            gtk-update-icon-cache -f -t /usr/share/icons/hicolor || true
        fi
        ;;
esac

exit 0
